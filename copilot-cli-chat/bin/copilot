#!/usr/bin/env bash
# GitHub Copilot CLI launcher.
# Resolves the newest CLI build cached by the GitHub Copilot app.
# Installed by Copilot setup — safe to edit or delete.
CLI_ROOT="${HOME}/.cache/github-copilot-sdk/cli"
latest="$(ls -1 "$CLI_ROOT" 2>/dev/null | sort -V | tail -n1)"
bin="${CLI_ROOT}/${latest}/copilot"
if [ -z "$latest" ] || [ ! -x "$bin" ]; then
  echo "copilot: no cached CLI build found under $CLI_ROOT" >&2
  echo "Open the GitHub Copilot desktop app once to install it, or run: npm i -g @github/copilot" >&2
  exit 127
fi
exec "$bin" "$@"
