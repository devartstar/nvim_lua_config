#!/usr/bin/env python3
# copilot-thoughts — print Copilot's reasoning ("thoughts") for the MOST RECENT
# answer in a session (the reasoning recorded after the last user message).
#
#   copilot-thoughts <session-id | path/to/events.jsonl>
#
# Read-only. Installed by the Copilot setup helper.
import sys, os, json


def events_path(arg):
    if os.path.isfile(arg):
        return arg
    return os.path.expanduser(f"~/.copilot/session-state/{arg}/events.jsonl")


def main():
    if len(sys.argv) < 2:
        sys.exit(0)
    path = events_path(sys.argv[1])
    if not os.path.isfile(path):
        sys.exit(0)

    events = []
    with open(path, errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line or line[0] != "{":
                continue
            try:
                events.append(json.loads(line))
            except Exception:
                continue

    last_user = -1
    for i, o in enumerate(events):
        if o.get("type") == "user.message" and ((o.get("data") or {}).get("content") or "").strip():
            last_user = i

    reasons = []
    for o in events[last_user + 1:]:
        if o.get("type") == "assistant.message":
            rt = ((o.get("data") or {}).get("reasoningText") or "").strip()
            if rt:
                reasons.append(rt)

    if reasons:
        sys.stdout.write("\n\n".join(reasons))


if __name__ == "__main__":
    main()
